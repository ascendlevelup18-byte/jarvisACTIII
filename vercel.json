{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm ci --prefix apps/web",
  "buildCommand": "npm run web:build",
  "outputDirectory": "apps/web/dist",
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  },
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/cases",
      "destination": "/api/cases"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
