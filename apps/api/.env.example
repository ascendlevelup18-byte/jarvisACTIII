# JARVIS AI env (apps/api)

# Mode: fixture (default) | vllm
# - fixture: deterministic adapters; no remote endpoint required
# - vllm: real OpenAI-compatible endpoint. Startup requires GET /models to list
#   JARVIS_MODEL_NAME and one synthetic probe per adapter to return schema-valid
#   JSON; otherwise the process exits 1. Never falls back to fixture.
JARVIS_AI_MODE=fixture

# Required when JARVIS_AI_MODE=vllm (OpenAI-compatible root, include /v1)
# JARVIS_MODEL_BASE_URL=http://your-mi300x-host:8000/v1
# JARVIS_MODEL_NAME=your-served-model-name

# Optional bearer token if the endpoint requires --api-key
# JARVIS_MODEL_API_KEY=

# Request timeout in milliseconds (must be a positive integer)
JARVIS_MODEL_TIMEOUT_MS=30000

# Structured output: json_schema (default; sends response_format) | off
# Set "off" only if the server rejects response_format; startup still probes strict parsing.
# JARVIS_MODEL_STRUCTURED_OUTPUT=json_schema

# API listen port (unchanged)
PORT=3000

# ---- Case ingress security (all entry points) ----
# Bearer token for privileged free-text cases (>= 24 chars, server-side only; never in the UI).
# Unset: only the four public demo scenarios are accepted.
# JARVIS_CASES_TOKEN=

# Limits (in-process; global only for a single long-running server)
# JARVIS_MAX_CONCURRENT_CASES=2
# JARVIS_RATE_LIMIT_PER_MINUTE=30
# Required when JARVIS_AI_MODE=vllm (2 model calls are reserved per case):
# JARVIS_DAILY_MODEL_CALL_BUDGET=200
# Key rate limits on X-Forwarded-For only behind a trusted proxy:
# JARVIS_TRUST_PROXY=1
