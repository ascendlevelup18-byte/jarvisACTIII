# JARVIS AI env (apps/api) — pre-kickoff scaffold

# Mode: fixture (default) | vllm
# - fixture: deterministic adapters; no remote endpoint required
# - vllm: validates endpoint config, but pre-kickoff build REFUSES to start
#   until VllmRequestUnderstandingAdapter / VllmModelAdapter are implemented
JARVIS_AI_MODE=fixture

# Required when JARVIS_AI_MODE=vllm (OpenAI-compatible root, include /v1)
# JARVIS_MODEL_BASE_URL=http://your-mi300x-host:8000/v1
# JARVIS_MODEL_NAME=your-served-model-name

# Optional bearer token if the endpoint requires --api-key
# JARVIS_MODEL_API_KEY=

# Request timeout in milliseconds (must be a positive integer)
JARVIS_MODEL_TIMEOUT_MS=30000

# API listen port (unchanged)
PORT=3000
