{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS: autonomous ecommerce exception resolver (duplicate charge workflow)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "api:start": "node apps/api/src/main.ts",
    "api:typecheck": "tsc -p apps/api",
    "api:test": "node --test apps/api/test/*.test.ts",
    "api:check": "npm run api:typecheck && npm run api:test",
    "api:bench": "node apps/api/eval/run-benchmark.ts",
    "api:bench:ci": "node apps/api/eval/run-benchmark.ts --ci",
    "web:dev": "npm run dev --prefix apps/web",
    "web:build": "npm run build --prefix apps/web",
    "web:typecheck": "npm run build --prefix apps/web",
    "web:test": "node --test --experimental-strip-types apps/web/test/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
