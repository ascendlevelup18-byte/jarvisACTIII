PORT=3000

# "vllm" for the AMD-hosted model, "offline" for the local heuristic stub (dev only).
LLM_MODE=vllm
# OpenAI-compatible root of the vLLM server (include /v1).
VLLM_BASE_URL=http://your-mi300x-host:8000/v1
VLLM_MODEL=your-served-model-name
# Only if vLLM was started with --api-key.
# VLLM_API_KEY=
# Set false if your vLLM version rejects response_format json_schema.
VLLM_STRUCTURED_OUTPUT=true
LLM_TIMEOUT_MS=30000

# Kill switch: refunds only execute when true.
AUTO_REFUND_ENABLED=true

# Optional JSONL mirror of the audit trail.
# AUDIT_LOG_PATH=./audit.jsonl
SEED_DEMO_DATA=true
