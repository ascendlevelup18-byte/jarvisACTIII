{
  "datasetId": "jarvis-duplicate-charge-eval",
  "version": "1.0.0",
  "description": "Pre-kickoff controlled evaluation set for the duplicate-charge workflow. Synthetic data only. Ground truth reflects the refund policy and what a competent operations specialist should do; it was written before the benchmark was first run and is not tuned to engine output.",
  "cases": [
    {
      "id": "DC-S01",
      "category": "STRAIGHTFORWARD",
      "title": "Valid duplicate payment",
      "world": {
        "customers": [{ "id": "CUST-2101", "name": "Avery Synthetic" }],
        "orders": [{ "id": "50101", "customerId": "CUST-2101", "totalMinor": 8999, "currency": "USD" }],
        "transactions": [
          { "id": "PAY-50101-A", "orderId": "50101", "customerId": "CUST-2101", "amountMinor": 8999, "currency": "USD", "status": "SUCCEEDED", "minutesAgo": 1440 },
          { "id": "PAY-50101-B", "orderId": "50101", "customerId": "CUST-2101", "amountMinor": 8999, "currency": "USD", "status": "SUCCEEDED", "minutesAgo": 1438.5 }
        ]
      },
      "request": { "customerId": "CUST-2101", "orderId": "50101", "message": "I was charged twice for order #50101." },
      "expected": { "finalState": "RESOLVED", "action": { "type": "REFUND", "transactionId": "PAY-50101-B", "amountMinor": 8999 }, "humanEscalation": false },
      "risk": "MEDIUM",
      "tags": ["duplicate", "happy-path"],
      "rationale": "Two identical successful charges 90s apart on an $89.99 order; policy permits refunding the later charge."
    },
    {
